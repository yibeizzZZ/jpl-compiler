read image "sample.png" to sample_image[H_image, W_image]

fn sepia(i: int, j: int, W: int, H: int) : rgba {
    let p = sample_image[i,j]
    let new_r = 0.393 * p.r + 0.769 * p.g + 0.189 * p.b
    let new_g = 0.349 * p.r + 0.686 * p.g + 0.168 * p.b
    let new_b = 0.272 * p.r + 0.534 * p.g + 0.131 * p.b
    return rgba {\
        if new_r > 1.0 then 1.0 else new_r,\
        if new_g > 1.0 then 1.0 else new_g,\
        if new_b > 1.0 then 1.0 else new_b,\
        p.a\
    }
}

time let sepia_image = array[i : H_image, j : W_image] sepia(i,j,W_image,H_image)
write image sepia_image to "sample-sepia.png"
